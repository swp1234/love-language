  "scenarios": {
    "s1": { "title": "\u041f\u043e\u0441\u043b\u0435 \u0441\u0442\u0440\u0435\u0441\u0441\u043e\u0432\u043e\u0433\u043e \u0434\u043d\u044f...", "prompt": "\u0412\u044b \u0443\u0441\u0442\u0430\u043b\u0438 \u0434\u043e \u0438\u0437\u043d\u0435\u043c\u043e\u0436\u0435\u043d\u0438\u044f. \u0427\u0442\u043e \u0434\u0430\u0441\u0442 \u043e\u0449\u0443\u0449\u0435\u043d\u0438\u0435 \u043b\u044e\u0431\u0432\u0438, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b \u043f\u0440\u0438\u0434\u0451\u0442\u0435 \u0434\u043e\u043c\u043e\u0439?", "W": "\u0421\u043b\u043e\u0432\u0430 \u00ab\u0422\u044b \u0441\u0435\u0433\u043e\u0434\u043d\u044f \u0442\u0430\u043a \u0441\u0442\u0430\u0440\u0430\u043b\u0441\u044f, \u044f \u0433\u043e\u0440\u0436\u0443\u0441\u044c \u0442\u043e\u0431\u043e\u0439\u00bb", "G": "\u041d\u0435\u0431\u043e\u043b\u044c\u0448\u043e\u0439 \u0441\u044e\u0440\u043f\u0440\u0438\u0437-\u043f\u043e\u0434\u0430\u0440\u043e\u043a \u043d\u0430 \u0441\u0442\u043e\u043b\u0435", "A": "\u0423\u0436\u0438\u043d \u0443\u0436\u0435 \u043f\u0440\u0438\u0433\u043e\u0442\u043e\u0432\u043b\u0435\u043d", "T": "\u041f\u0430\u0440\u0442\u043d\u0451\u0440 \u0431\u0440\u043e\u0441\u0430\u0435\u0442 \u0432\u0441\u0451 \u0438 \u0441\u0430\u0434\u0438\u0442\u0441\u044f \u043f\u043e\u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c", "P": "\u0414\u043e\u043b\u0433\u0438\u0435 \u0442\u0451\u043f\u043b\u044b\u0435 \u043e\u0431\u044a\u044f\u0442\u0438\u044f \u043d\u0430 \u043f\u043e\u0440\u043e\u0433\u0435" },

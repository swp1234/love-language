    "A": "\u3042\u306a\u305f\u306e\u611b\u306e\u8a00\u8449\u306f\u300c\u5949\u4ed5\u306e\u884c\u70ba\u300d\u3067\u3059\u3002\u8ab0\u304b\u304c\u3042\u306a\u305f\u306e\u305f\u3081\u306b\u4f55\u304b\u3092\u300c\u3057\u3066\u304f\u308c\u308b\u3053\u3068\u300d\u304b\u3089\u6700\u3082\u6df1\u3044\u611b\u3092\u611f\u3058\u307e\u3059\u3002\u8a00\u8449\u3088\u308a\u3082\u884c\u52d5\u304c\u306f\u308b\u304b\u306b\u5f37\u304f\u97ff\u304d\u307e\u3059\u3002",
    "G": "\u3042\u306a\u305f\u306e\u611b\u306e\u8a00\u8449\u306f\u300c\u8d08\u308a\u7269\u300d\u3067\u3059\u3002\u30d7\u30ec\u30bc\u30f3\u30c8\u81ea\u4f53\u306e\u4fa1\u683c\u304c\u91cd\u8981\u306a\u306e\u3067\u306f\u306a\u304f\u3001\u300c\u6c17\u6301\u3061\u300d\u304c\u8fbc\u3081\u3089\u308c\u305f\u30d7\u30ec\u30bc\u30f3\u30c8\u304c\u3042\u306a\u305f\u306e\u5fc3\u3092\u52d5\u304b\u3057\u307e\u3059\u3002",
    "T": "\u3042\u306a\u305f\u306e\u611b\u306e\u8a00\u8449\u306f\u300c\u5145\u5b9f\u3057\u305f\u6642\u9593\u300d\u3067\u3059\u3002\u76f8\u624b\u304c\u81ea\u5206\u306b\u5168\u529b\u3067\u96c6\u4e2d\u3057\u3066\u304f\u308c\u308b\u6642\u9593\u304c\u611b\u3067\u3059\u3002\u30b9\u30de\u30db\u3092\u7f6e\u3044\u3066\u76ee\u3092\u5408\u308f\u305b\u306a\u304c\u3089\u771f\u5263\u306b\u8a71\u3057\u305f\u308a\u3059\u308b\u3053\u3068\u304c\u6700\u9ad8\u306e\u611b\u60c5\u8868\u73fe\u3067\u3059\u3002",
    "P": "\u3042\u306a\u305f\u306e\u611b\u306e\u8a00\u8449\u306f\u300c\u8eab\u4f53\u7684\u63a5\u89e6\u300d\u3067\u3059\u3002\u611b\u306f\u808c\u3067\u611f\u3058\u308b\u3082\u306e\u3067\u3059\u3002\u30cf\u30b0\u3001\u624b\u3092\u3064\u306a\u3050\u3001\u80cc\u4e2d\u3092\u512a\u3057\u304f\u305f\u305f\u304f\u3068\u3044\u3063\u305f\u5c0f\u3055\u306a\u30b9\u30ad\u30f3\u30b7\u30c3\u30d7\u304c\u3001\u8a00\u8449\u3084\u30d7\u30ec\u30bc\u30f3\u30c8\u3088\u308a\u306f\u308b\u304b\u306b\u5f37\u3044\u5b89\u5fc3\u611f\u3068\u3064\u306a\u304c\u308a\u3092\u4e0e\u3048\u3066\u304f\u308c\u307e\u3059\u3002"
  },
  "advice": {
    "W": "\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u3001\u79f0\u8cdb\u3084\u52b1\u307e\u3057\u306e\u8a00\u8449\u304c\u3069\u308c\u307b\u3069\u5927\u304d\u306a\u610f\u5473\u3092\u6301\u3064\u304b\u3092\u7387\u76f4\u306b\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002\u300c\u3042\u308a\u304c\u3068\u3046\u300d\u300c\u611b\u3057\u3066\u308b\u300d\u300c\u3088\u304f\u3067\u304d\u305f\u306d\u300d\u3068\u3044\u3063\u305f\u7c21\u5358\u306a\u8a00\u8449\u3092\u6bce\u65e5\u7fd2\u6163\u306e\u3088\u3046\u306b\u4ea4\u308f\u3059\u3068\u3001\u95a2\u4fc2\u304c\u305a\u3063\u3068\u8c4a\u304b\u306b\u306a\u308a\u307e\u3059\u3002",
    "A": "\u3069\u3093\u306a\u52a9\u3051\u304c\u5fc5\u8981\u304b\u3092\u5177\u4f53\u7684\u306b\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002\u30d1\u30fc\u30c8\u30ca\u30fc\u306e\u884c\u52d5\u306b\u5fc5\u305a\u611f\u8b1d\u3092\u8868\u3057\u3001\u305d\u306e\u884c\u52d5\u304c\u3069\u308c\u307b\u3069\u5927\u304d\u306a\u611b\u3068\u3057\u3066\u611f\u3058\u308b\u304b\u3092\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002",
    "G": "\u30d7\u30ec\u30bc\u30f3\u30c8\u304c\u3042\u306a\u305f\u306b\u3068\u3063\u3066\u3069\u308c\u307b\u3069\u5927\u5207\u304b\u3001\u305d\u3057\u3066\u9ad8\u4fa1\u3067\u306a\u304f\u3066\u3082\u5fc3\u304c\u8fbc\u3081\u3089\u308c\u3066\u3044\u308c\u3070\u5341\u5206\u3060\u3068\u3044\u3046\u3053\u3068\u3092\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002",
    "T": "\u300c\u5b8c\u5168\u306b\u4e8c\u4eba\u3060\u3051\u3067\u904e\u3054\u3059\u6642\u9593\u300d\u304c\u3069\u308c\u307b\u3069\u5927\u5207\u304b\u3092\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u4f1d\u3048\u307e\u3057\u3087\u3046\u3002\u30c7\u30fc\u30c8\u306e\u6642\u306f\u30b9\u30de\u30db\u3092\u6700\u5c0f\u9650\u306b\u3057\u3066\u3001\u304a\u4e92\u3044\u306b\u96c6\u4e2d\u3059\u308b\u30eb\u30fc\u30eb\u3092\u4f5c\u308a\u307e\u3057\u3087\u3046\u3002",
    "P": "\u30b9\u30ad\u30f3\u30b7\u30c3\u30d7\u304c\u3069\u308c\u307b\u3069\u5b89\u5fc3\u611f\u3092\u4e0e\u3048\u3066\u304f\u308c\u308b\u304b\u3092\u30d1\u30fc\u30c8\u30ca\u30fc\u306b\u4f1d\u3048\u3001\u304a\u4e92\u3044\u304c\u5fc3\u5730\u3088\u3044\u30ec\u30d9\u30eb\u306e\u8eab\u4f53\u7684\u63a5\u89e6\u3092\u4e00\u7dd2\u306b\u6c7a\u3081\u307e\u3057\u3087\u3046\u3002"
  },

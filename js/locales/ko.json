  "scenarios": {
    "s1": {
      "title": "\ud798\ub4e0 \ud558\ub8e8 \ud6c4...",
      "prompt": "\ud53c\uace4\ud55c \ud558\ub8e8\ub97c \ubcf4\ub0c8\uc2b5\ub2c8\ub2e4. \uc9d1\uc5d0 \ub3cc\uc544\uc654\uc744 \ub54c \uc5b4\ub5a4 \uac83\uc774 \uac00\uc7a5 \uc0ac\ub791\ubc1b\ub294 \ub290\ub08c\uc744 \uc904\uae4c\uc694?",
      "W": "\"\uc624\ub298 \uc815\ub9d0 \uace0\uc0dd\ud588\uc5b4, \ub300\ub2e8\ud574\"\ub77c\ub294 \ub9d0",
      "G": "\ud14c\uc774\ube14\uc5d0 \ub193\uc5ec\uc788\ub294 \uc791\uc740 \uae5c\uc9dd \uc120\ubb3c",
      "A": "\ub530\ub73b\ud55c \uc2dd\uc0ac\uac00 \uc774\ubbf8 \uc900\ube44\ub418\uc5b4 \uc788\ub294 \uac83",
      "T": "\ud30c\ud2b8\ub108\uac00 \ubaa8\ub4e0 \uac83\uc744 \uba48\ucd94\uace0 \ud568\uaed8 \uc571\uc544\uc11c \uc774\uc57c\uae30\ud558\ub294 \uac83",
      "P": "\ub4e4\uc5b4\uc624\uc790\ub9c8\uc790 \uae38\uace0 \ub530\ub73b\ud55c \ud3ec\uc639"
    },
    "s2": {
      "title": "\uc0dd\uc77c\uc5d0...",
      "prompt": "\uc0dd\uc77c\uc785\ub2c8\ub2e4. \uc5b4\ub5a4 \uac83\uc774 \uac00\uc7a5 \ud2b9\ubcc4\ud558\uac8c \ub290\uaef4\uc9c8\uae4c\uc694?",
      "W": "\ub2f9\uc2e0\uc774 \uc5bc\ub9c8\ub098 \uc18c\uc911\ud55c\uc9c0 \uc801\uc740 \uc9c4\uc2ec \uc5b4\ub9b0 \ud3b8\uc9c0",
      "G": "\ub2f9\uc2e0\uc744 \uc798 \uc54c\uace0 \uc788\ub2e4\ub294 \uac83\uc744 \ubcf4\uc5ec\uc8fc\ub294 \uc138\uc2ec\ud55c \uc120\ubb3c",
      "A": "\ud558\ub8e8 \uc804\uccb4\ub97c \uc9c1\uc811 \uacc4\ud68d\ud558\uace0 \uc900\ube44\ud574\uc8fc\ub294 \uac83",
      "T": "\uc88b\uc544\ud558\ub294 \uac83\ub4e4\uc744 \ud568\uaed8 \ud558\uba70 \ubcf4\ub0b4\ub294 \ud558\ub8e8",
      "P": "\uc544\uce68\uc5d0 \uae68\uba74 \uc2a4\ud0a8\uc2ed\uacfc \uc560\uc815\uc73c\ub85c \uac00\ub4dd"
    },
    "s3": {
      "title": "\uc0c8\ub85c\uc6b4 \uad00\uacc4\uc5d0\uc11c...",
      "prompt": "\uc0c8\ub85c\uc6b4 \uc0ac\ub78c\uc744 \uc54c\uc544\uac00\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5a4 \uac83\uc774 \uac00\uc7a5 \uac15\ud55c \uc5f0\uacb0\uac10\uc744 \ub290\ub07c\uac8c \ud560\uae4c\uc694?",
      "W": "\uc9c4\uc2ec\uc73c\ub85c \uc874\uacbd\uc744 \ud45c\ud604\ud558\ub294 \uae4a\uc740 \ub300\ud654",
      "G": "\ub0b4\uac00 \ub9d0\ud55c \uac83\uc744 \uae30\uc5b5\ud574\uc11c \uae5c\uc9dd \uc120\ubb3c\ud574\uc8fc\ub294 \uac83",
      "A": "\ub098\ub97c \ub3c4\uc640\uc8fc\ub824\uace0 \ubc88\uac70\ub85c\uc6c0\uc744 \uac10\uc218\ud558\ub294 \uac83",
      "T": "\ud568\uaed8 \uc788\uc73c\uba74 \uc2dc\uac04\uc774 \ub0a0\uc544\uac08 \uc815\ub3c4, \ud578\ub4dc\ud3f0\ub3c4 \ud544\uc694 \uc5c6\ub294 \uac83",
      "P": "\ucc98\uc74c \uc190\uc744 \uc7a1\uc558\uc744 \ub54c\uc758 \uc804\ub9c7\uac19\uc740 \ub290\ub08c"
    },
    "s4": {
      "title": "\uae30\ubd84\uc774 \uc548 \uc88b\uc744 \ub54c...",
      "prompt": "\uac10\uc815\uc801\uc73c\ub85c \ud798\ub4e0 \uc2dc\uae30\ub97c \ubcf4\ub0b4\uace0 \uc788\uc2b5\ub2c8\ub2e4. \uc5b4\ub5a4 \uac83\uc774 \uac00\uc7a5 \uc704\ub85c\uac00 \ub420\uae4c\uc694?",
      "W": "\"\ub108\ub97c \ubbff\uc5b4, \ubd84\uba85 \uc774\uaca8\ub0bc \uc218 \uc788\uc5b4\"\ub77c\ub294 \uc548\uc2ec\uc758 \ub9d0",
      "G": "\uc88b\uc544\ud558\ub294 \uac04\uc2dd\uc744 \uc0ac\ub2e4 \uc8fc\ub294 \uac83",
      "A": "\ub0b4 \ud560 \uc77c\uc744 \ub300\uc2e0 \ucc98\ub9ac\ud574\uc918\uc11c \uc26c\uac8c \ud574\uc8fc\ub294 \uac83",
      "T": "\uc2a4\ucf00\uc904\uc744 \ube44\uc6cc\uc11c \uadf8\ub0e5 \uc606\uc5d0 \uc788\uc5b4\uc8fc\ub294 \uac83",
      "P": "\uae30\ubd84\uc774 \ub098\uc544\uc9c8 \ub54c\uae4c\uc9c0 \ub9d0\uc5c6\uc774 \uc548\uaca8\uc8fc\ub294 \uac83"
    },
    "s5": {
      "title": "\uc8fc\ub9d0\uc5d0 \ud568\uaed8...",
      "prompt": "\ud30c\ud2b8\ub108\uc640 \uc790\uc720\ub85c\uc6b4 \uc8fc\ub9d0\uc774 \uc788\uc2b5\ub2c8\ub2e4. \uc774\uc0c1\uc801\uc778 \ud65c\ub3d9\uc758 \uc21c\uc704\ub97c \uc815\ud574\uc8fc\uc138\uc694.",
      "W": "\uc544\ub298\ud55c \uce74\ud398\uc5d0\uc11c \uc9c4\uc2ec \uc5b4\ub9b0 \ub300\ud654",
      "G": "\uc11c\ub85c\uc5d0\uac8c \uc120\ubb3c\uc744 \uace8\ub77c\uc8fc\uba70 \uc1fc\ud551\ud558\uae30",
      "A": "\ud568\uaed8 \uc9d1 \ud504\ub85c\uc81d\ud2b8\ub97c \ud558\uba70 \ud611\ub825\ud558\uae30",
      "T": "\ud578\ub4dc\ud3f0 \ub044\uace0 \uc989\ud765\uc801\uc778 \ubaa8\ud5d8",
      "P": "\uce68\ub300\uc5d0\uc11c \ub290\uae0b\ud558\uac8c \uaef4\uc548\uace0 \uac00\uae4c\uc774 \uc788\uae30"
    },
    "s6": {
      "title": "\uc0ac\ub791\uc744 \ud45c\ud604\ud558\ub294 \ubc29\ubc95...",
      "prompt": "\ub204\uad70\uac00\uc5d0\uac8c \ub9c8\uc74c\uc744 \ud45c\ud604\ud558\uace0 \uc2f6\uc744 \ub54c, \uc790\uc5f0\uc2a4\ub7fd\uac8c \uc5b4\ub5bb\uac8c \ud558\ub098\uc694?",
      "W": "\uc5bc\ub9c8\ub098 \uba4b\uc9c4 \uc0ac\ub78c\uc778\uc9c0 \uba54\uc2dc\uc9c0\ub97c \uc368\uc8fc\ub294 \uac83",
      "G": "\uadf8 \uc0ac\ub78c\uc5d0\uac8c \ub531 \ub9de\ub294 \uc138\uc2ec\ud55c \uc120\ubb3c\uc744 \uace8\ub77c\uc8fc\ub294 \uac83",
      "A": "\ud574\uc57c \ud560 \uc77c\uc744 \ub3c4\uc640\uc8fc\uac70\ub098 \ubb38\uc81c\ub97c \ud574\uacb0\ud574\uc8fc\ub294 \uac83",
      "T": "\uc628\uc804\ud788 \uc9d1\uc911\ud574\uc11c \ud568\uaed8 \uc2dc\uac04\uc744 \ubcf4\ub0b4\ub294 \uac83",
      "P": "\ub530\ub73b\ud55c \ud3ec\uc639\uc774\ub098 \uc704\ub85c\uc758 \uc190\uae38\uc744 \uac74\ub124\ub294 \uac83"
    },
    "s7": {
      "title": "\uac00\uc7a5 \uadf8\ub9ac\uc6b4 \uac83...",
      "prompt": "\uc7a5\uac70\ub9ac \uc0c1\ud669\uc5d0\uc11c \uac00\uc7a5 \uadf8\ub9ac\uc6b8 \uac83\uc740 \ubb34\uc5c7\uc778\uac00\uc694?",
      "W": "\"\uc0ac\ub791\ud574\", \"\uc798 \uc790\"\ub77c\uace0 \uc804\ud574\uc8fc\ub294 \ubaa9\uc18c\ub9ac",
      "G": "\uc6b0\ud3b8\uc73c\ub85c \ub3c4\ucc29\ud558\ub294 \uae5c\uc9dd \uc120\ubb3c \ubc15\uc2a4",
      "A": "\ud568\uaed8 \uc77c\uc744 \ucc98\ub9ac\ud574\uc8fc\ub294 \uc0ac\ub78c\uc774 \uc788\ub294 \uac83",
      "T": "\uac19\uc740 \ubc29\uc5d0 \uadf8\ub0e5 \ud568\uaed8 \uc788\ub294 \uc77c\uc0c1\uc758 \uc21c\uac04\ub4e4",
      "P": "\ud3ec\uc639, \uc190\uc7a1\uae30, \uccb4\uc628\u2014\uc2e0\uccb4\uc801 \uac00\uae4c\uc6c0"
    },
    "s8": {
      "title": "\uc644\ubcbd\ud55c \uae30\ub150\uc77c...",
      "prompt": "\uc774\uc0c1\uc801\uc778 \uae30\ub150\uc77c\uc744 \uc0c1\uc0c1\ud574\ubcf4\uc138\uc694. \uac00\uc7a5 \uc911\uc694\ud55c \uac83\uc758 \uc21c\uc704\ub97c \uc815\ud574\uc8fc\uc138\uc694.",
      "W": "\ud568\uaed8\ud55c \uc5ec\uc815\uc5d0 \ub300\ud55c \uc9c4\uc2ec \uc5b4\ub9b0 \uac74\ubc30 \uc0ac",
      "G": "\uc758\ubbf8 \uc788\uace0 \uac1c\uc778\ud654\ub41c \uc120\ubb3c \uad50\ud658",
      "A": "\ud30c\ud2b8\ub108\uac00 \ubaa8\ub4e0 \uac83\uc744 \uc644\ubcbd\ud558\uac8c \uc900\ube44\ud574\uc900 \uac83",
      "T": "\uc624\uc9c1 \ub458\ub9cc\uc758, \ubc29\ud574 \uc5c6\ub294 \uc800\ub141 \uc2dc\uac04",
      "P": "\ubc14\uc9dd \ubd99\uc5b4 \ucd94\uba70, \uc800\ub141 \ub0b4\ub0b4 \uc190\uc744 \uc7a1\ub294 \uac83"
    }
  },
  "result": {
    "primaryLabel": "\ub2f9\uc2e0\uc758 \uc8fc\uc694 \uc0ac\ub791\uc758 \uc5b8\uc5b4",
    "secondaryLabel": "\ubcf4\uc870",
    "breakdown": "\uc0ac\ub791\uc758 \uc5b8\uc5b4 \ubd84\uc11d",
    "compatTitle": "\ud83d\udc91 \uad81\ud569\uc774 \uc798 \ub9de\ub294 \uc5b8\uc5b4",
    "adviceTitle": "\uad00\uacc4 \uc870\uc5b8",
    "retry": "\ub2e4\uc2dc \ud14c\uc2a4\ud2b8\ud558\uae30"
  },
  "desc": {
    "W": "\ub2f9\uc2e0\uc758 \uc0ac\ub791\uc758 \uc5b8\uc5b4\ub294 '\uc778\uc815\uc758 \ub9d0'\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub9d0\uc744 \ud1b5\ud574 \uc0ac\ub791\uc744 \ub290\ub07c\uace0 \ud45c\ud604\ud569\ub2c8\ub2e4. \ud30c\ud2b8\ub108\uc758 \uc9c4\uc2ec \uc5b4\ub9b0 \uce6d\ucc2c, \uac10\uc0ac \ud45c\ud604, \uc0ac\ub791 \uace0\ubc31\uc740 \ub2f9\uc2e0\uc758 \ub9c8\uc74c\uc744 \uac00\ub4dd \ucc44\uc6b0\ub294 \uac00\uc7a5 \uac15\ub825\ud55c \ubc29\ubc95\uc785\ub2c8\ub2e4.",
    "A": "\ub2f9\uc2e0\uc758 \uc0ac\ub791\uc758 \uc5b8\uc5b4\ub294 '\ubd09\uc0ac \ud589\ub3d9'\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc740 \ub204\uad70\uac00\uac00 \ub2f9\uc2e0\uc744 \uc704\ud574 \ubb34\uc5b8\uac00\ub97c '\ud574\uc8fc\ub294 \uac83'\uc5d0\uc11c \uac00\uc7a5 \uae4a\uc740 \uc0ac\ub791\uc744 \ub290\ub08d\ub2c8\ub2e4. \ub9d0\ubcf4\ub2e4 \ud589\ub3d9\uc774 \ud6e8\uc52c \uac15\ub825\ud558\uac8c \ub2e4\uac00\uc635\ub2c8\ub2e4.",
    "G": "\ub2f9\uc2e0\uc758 \uc0ac\ub791\uc758 \uc5b8\uc5b4\ub294 '\uc120\ubb3c \ubc1b\uae30'\uc785\ub2c8\ub2e4. \uc120\ubb3c \uc790\uccb4\uc758 \uac00\uaca9\uc774 \uc911\uc694\ud55c \uac83\uc774 \uc544\ub2c8\ub77c, \ub2f9\uc2e0\uc744 \uc0dd\uac01\ud558\uba70 \uc815\uc131\uc2a4\ub7fd\uac8c \uc900\ube44\ud55c '\ub9c8\uc74c'\uc774 \ub2f4\uae34 \uc120\ubb3c\uc774 \ub2f9\uc2e0\uc758 \ub9c8\uc74c\uc744 \uc6c0\uc9c1\uc785\ub2c8\ub2e4.",
    "T": "\ub2f9\uc2e0\uc758 \uc0ac\ub791\uc758 \uc5b8\uc5b4\ub294 '\ud568\uaed8\ud558\ub294 \uc2dc\uac04'\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc5d0\uac8c \uc0ac\ub791\uc774\ub780 \uc0c1\ub300\ubc29\uc774 \ub098\uc5d0\uac8c \uc628\uc804\ud788 \uc9d1\uc911\ud574\uc8fc\ub294 \uc2dc\uac04\uc785\ub2c8\ub2e4. \ud578\ub4dc\ud3f0\uc744 \ub0b4\ub824\ub193\uace0 \ub208\uc744 \ub9de\ucd94\uba70 \uc9c4\uc2ec\uc73c\ub85c \ub300\ud654\ud558\ub294 \uac83\uc774 \ucd5c\uace0\uc758 \uc0ac\ub791 \ud45c\ud604\uc785\ub2c8\ub2e4.",
    "P": "\ub2f9\uc2e0\uc758 \uc0ac\ub791\uc758 \uc5b8\uc5b4\ub294 '\uc2e0\uccb4 \uc811\ucd09'\uc785\ub2c8\ub2e4. \ub2f9\uc2e0\uc5d0\uac8c \uc0ac\ub791\uc740 \ud53c\ubd80\ub85c \ub290\ub07c\ub294 \uac83\uc785\ub2c8\ub2e4. \ud3ec\uc639, \uc190 \uc7a1\uae30, \ub4f1 \ub450\ub4dc\ub9ac\uae30\uc640 \uac19\uc740 \uc791\uc740 \uc2a4\ud0a8\uc2ed\uc774 \ub9d0\uc774\ub098 \uc120\ubb3c\ubcf4\ub2e4 \ud6e8\uc52c \uac15\ud55c \uc548\uc815\uac10\uacfc \uc5f0\uacb0\uac10\uc744 \uc90d\ub2c8\ub2e4."
  },
  "advice": {
    "W": "\ud30c\ud2b8\ub108\uc5d0\uac8c \ub2f9\uc2e0\uc774 \uce6d\ucc2c\uacfc \uaca9\ub824\uc758 \ub9d0\uc5d0 \uc5bc\ub9c8\ub098 \ud070 \uc758\ubbf8\ub97c \ub450\ub294\uc9c0 \uc194\uc9c1\ud558\uac8c \uc774\uc57c\uae30\ud558\uc138\uc694. '\uace0\ub9c8\uc6cc', '\uc0ac\ub791\ud574', '\uc798\ud588\uc5b4' \uac19\uc740 \uac04\ub2e8\ud55c \ub9d0\ub4e4\ub3c4 \ub9e4\uc77c \uc2b5\uad00\ucc98\ub7fc \uc8fc\uace0\ubc1b\uc73c\uba74 \uad00\uacc4\uac00 \ud6e8\uc52c \ud48d\uc694\ub85c\uc6cc\uc9d1\ub2c8\ub2e4.",
    "A": "\ud30c\ud2b8\ub108\uc5d0\uac8c \uad6c\uccb4\uc801\uc73c\ub85c \uc5b4\ub5a4 \ub3c4\uc6c0\uc774 \ud544\uc694\ud55c\uc9c0 \uba85\ud655\ud558\uac8c \uc804\ub2ec\ud558\uc138\uc694. \ud30c\ud2b8\ub108\uc758 \ubd09\uc0ac \ud589\ub3d9\uc5d0 \ubc18\ub4dc\uc2dc \uac10\uc0ac\ub97c \ud45c\ud604\ud558\uace0, \uadf8 \ud589\ub3d9\uc774 \ub2f9\uc2e0\uc5d0\uac8c \uc5bc\ub9c8\ub098 \ud070 \uc0ac\ub791\uc73c\ub85c \ub290\uaef4\uc9c0\ub294\uc9c0 \ub9d0\ud574\uc8fc\uc138\uc694.",
    "G": "\ud30c\ud2b8\ub108\uc5d0\uac8c \uc120\ubb3c\uc774 \ub2f9\uc2e0\uc5d0\uac8c \uc5bc\ub9c8\ub098 \ud070 \uc758\ubbf8\uc778\uc9c0, \uadf8\ub9ac\uace0 \ube44\uc2fc \uc120\ubb3c\uc774 \uc544\ub2c8\ub77c '\ub9c8\uc74c'\uc774 \ub2f4\uae34 \uc120\ubb3c\uc774\ub77c\uba74 \ucda9\ubd84\ud558\ub2e4\ub294 \uac83\uc744 \uc774\uc57c\uae30\ud574\uc8fc\uc138\uc694.",
    "T": "\ud30c\ud2b8\ub108\uc5d0\uac8c '\uc624\ub86f\uc774 \ud568\uaed8\ud558\ub294 \uc2dc\uac04'\uc774 \ub2f9\uc2e0\uc5d0\uac8c \uc5bc\ub9c8\ub098 \uc911\uc694\ud55c\uc9c0 \uc804\ub2ec\ud558\uc138\uc694. \ub370\uc774\ud2b8\ud560 \ub54c\ub294 \ud578\ub4dc\ud3f0\uc744 \ucd5c\uc18c\ud654\ud558\uace0 \uc11c\ub85c\uc5d0\uac8c \uc9d1\uc911\ud558\ub294 \uaddc\uce59\uc744 \ub9cc\ub4e4\uc5b4\ubcf4\uc138\uc694.",
    "P": "\ud30c\ud2b8\ub108\uc5d0\uac8c \uc2a4\ud0a8\uc2ed\uc774 \ub2f9\uc2e0\uc5d0\uac8c \uc5bc\ub9c8\ub098 \uc548\uc815\uac10\uc744 \uc8fc\ub294\uc9c0 \uc774\uc57c\uae30\ud558\uace0, \uc11c\ub85c \ud3b8\uc548\ud55c \uc218\uc900\uc758 \uc2e0\uccb4 \uc811\ucd09\uc744 \ud568\uaed8 \uc815\ud574\ubcf4\uc138\uc694."
  },

  "scenarios": {
    "s1": { "title": "\u0924\u0928\u093e\u0935\u092a\u0942\u0930\u094d\u0923 \u0926\u093f\u0928 \u0915\u0947 \u092c\u093e\u0926...", "prompt": "\u0925\u0915\u093e \u0926\u0947\u0928\u0947 \u0935\u093e\u0932\u093e \u0926\u093f\u0928 \u0925\u093e\u0964 \u0918\u0930 \u0906\u0928\u0947 \u092a\u0930 \u0915\u094d\u092f\u093e \u0938\u092c\u0938\u0947 \u091c\u094d\u092f\u093e\u0926\u093e \u092a\u094d\u092f\u093e\u0930 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b\u0917\u093e?", "W": "\"\u0906\u091c \u0906\u092a\u0928\u0947 \u092c\u0939\u0941\u0924 \u092e\u0947\u0939\u0928\u0924 \u0915\u0940, \u092e\u0941\u091d\u0947 \u0917\u0930\u094d\u0935 \u0939\u0948\" \u0938\u0941\u0928\u0928\u093e", "G": "\u092e\u0947\u091c\u093c \u092a\u0930 \u090f\u0915 \u091b\u094b\u091f\u093e \u0938\u0930\u092a\u094d\u0930\u093e\u0907\u091c\u093c \u0909\u092a\u0939\u093e\u0930", "A": "\u0918\u0930 \u092a\u0930 \u0917\u0930\u094d\u092e \u0916\u093e\u0928\u093e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0924\u0948\u092f\u093e\u0930", "T": "\u0938\u093e\u0925\u0940 \u0938\u092c \u091b\u094b\u0921\u093c\u0915\u0930 \u092c\u0948\u0920\u0915\u0930 \u092c\u093e\u0924 \u0915\u0930\u0947", "P": "\u0926\u0930\u0935\u093e\u091c\u093c\u0947 \u092a\u0930 \u090f\u0915 \u0932\u0902\u092c\u093e \u0917\u0930\u094d\u092e \u0906\u0932\u093f\u0902\u0917\u0928" },
